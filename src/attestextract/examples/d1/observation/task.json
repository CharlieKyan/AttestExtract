{
  "name": "synthetic-d1-observation",
  "description": "Extract each stated flow observation independently, preserving temperature conditions. Equal flow values at different temperatures are separate observations.",
  "record_types": {
    "flow_observation": {
      "description": "One observed flow for one sample at a reported temperature.",
      "fields": {
        "sample": {"type": "string", "description": "Sample name as stated.", "required": true},
        "flow": {"type": "number", "description": "Reported flow, without unit conversion.", "required": true},
        "flow_unit": {"type": "string", "description": "Flow unit as stated.", "required": true},
        "temperature": {"type": "number", "description": "Temperature for this observation.", "required": true},
        "temperature_unit": {"type": "string", "description": "Temperature unit as stated.", "required": true}
      },
      "identity_fields": ["sample"],
      "condition_fields": ["temperature", "temperature_unit"]
    }
  }
}

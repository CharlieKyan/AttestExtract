# Copy to .env, fill in values, then pass extract --env-file .env explicitly.
# Plain KEY=value data only: no PowerShell $env:, Read-Host, or Markdown links.
# Command-line options > existing process environment > this file.
ATTESTEXTRACT_BASE_URL=https://your-provider.example/v1
ATTESTEXTRACT_MODEL=your-model-name
ATTESTEXTRACT_API_KEY=replace-with-your-key

# Optional named profiles in examples/backends.toml use separate official keys.
# DEEPSEEK_API_KEY=replace-with-your-deepseek-key
# DASHSCOPE_API_KEY=replace-with-your-beijing-key
